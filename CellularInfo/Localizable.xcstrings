    "RebootCommCenterMessage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restart Cellular Service?\nRestarting baseband services will temporarily interrupt cellular network connectivity.\nIf your SIM or eSIM is PIN-protected, you may need to enter the PIN again to unlock it.\nIf you only need to refresh the cellular signal or connection, it is recommended to use “Refresh Cellular Connection” instead."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确认重启蜂窝网络服务？\n重启基带服务会暂时中断蜂窝网络连接。\n如果您的SIM卡或eSIM已设置PIN，可能需要再次输入 PIN 以解锁。\n如果您只是想刷新蜂窝网络信号，建议使用“刷新蜂窝网络信号”功能。"
          }
        }
      }
    },

    "NRAbsoluteRadioFrequencyChannelNumber" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NRARFCN: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5G绝对无线信道编号(NRARFCN): %@"
          }
        }
      }
    },
    "NRAbsoluteRadioFrequencyChannelNumberHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NR Absolute Radio Frequency Channel Number(NRARFCN) Identifies the radio channel number corresponding to the serving 5G carrier frequency.\nUnlike GSCN, which is used during cell search and synchronization to discover base stations, NRARFCN represents the actual carrier frequency used for data transmission."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5G绝对无线信道编号 NR Absolute Radio Frequency Channel Number(NRARFCN)用于标识设备当前连接的 5G 无线频率位置，是 5G 网络中定位业务载波频率的重要编号。\n与 GSCN（同步信号信道号）不同，NRARFCN 表示设备实际用于数据通信的载波频率，而 GSCN 主要用于终端在网络搜索和小区同步阶段发现基站。"
          }
        }
      }
    },
    "NRBWPSupport" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NR BWP Support: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5G动态频宽(BWP): %@"
          }
        }
      }
    },
    "NRBWPSupportExperimentalHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bandwidth Part (BWP) indicates whether the device supports dynamically using only part of the available 5G bandwidth.  \nThis feature helps improve power efficiency and allows the network to allocate radio resources more flexibly.\n\nThis value is more likely to reflect internal Bandwidth Part (BWP) configuration or capability rather than a standardized indicator of 5G Advanced (5GA). Based on observed behavior and partial references, it may use a bitmask representation to indicate support for Downlink (DL) and Uplink (UL) BWPs (e.g., a value of value is 3 may indicate support for both DL and UL)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5G动态频宽 Bandwidth Part (BWP) 表示设备是否支持在5G网络中动态仅使用部分可用带宽。  \n这有助于降低功耗，并提升网络资源分配效率。\n\n该数值更可能反映的是内部的带宽部分（BWP）配置或能力，而非标准化的 5G Advanced（5GA）指示。结合现有行为和部分参考文献分析，其取值可能采用位掩码形式，用于表示下行（Downlink）与上行（Uplink）BWP 的支持情况（例如数值为3可能表示同时支持下行与上行）。"
          }
        }
      }
    },
    "NRBWPSupportHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bandwidth Part (BWP) indicates whether the device supports dynamically using only part of the available 5G bandwidth.  \nThis feature helps improve power efficiency and allows the network to allocate radio resources more flexibly."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5G动态频宽 Bandwidth Part (BWP) 表示设备是否支持在5G网络中动态仅使用部分可用带宽。  \n这有助于降低功耗，并提升网络资源分配效率。"
          }
        }
      }
    },
    "NRConnected" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5G SA(NR): %@"
          }

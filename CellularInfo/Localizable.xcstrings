    },
    "BasebandReleaseCandidateFlagHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicates whether the device is in a Release Candidate (RC) state at the baseband or carrier configuration level. This flag is not related to iOS system versions and is believed to be used only in Apple's internal or carrier testing workflows. On retail devices, it is typically always disabled.\nThere is currently no known method to trigger or reproduce this state on consumer devices."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前设备是否处于基带或运营商配置的 RC（候选发布）阶段。该标志与 iOS 系统版本无关，推测仅用于 Apple 内部或运营商测试流程。在零售设备上通常始终为未启用。\n目前尚无已知方法触发或复现该状态。"
          }
        }
      }
    },

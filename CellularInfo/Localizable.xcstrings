    "NATKeepAliveIntervalHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicates the NAT traversal (NAT-T) keep-alive interval over cellular (in seconds). The system periodically sends keep-alive packets to maintain NAT mappings and prevent the connection from being dropped. Lower values increase keep-alive frequency but may result in higher power consumption."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该值表示蜂窝网络下 NAT 穿越（NAT-T）保活间隔（单位：秒）。系统会按该周期发送保活数据包，以维持 NAT 映射，防止连接被网络侧回收。数值越小，保活越频繁，但可能增加功耗。"
          }
        }
      }
    },

    "SNRHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SNR (Signal-to-Noise Ratio) measures the ratio between the received signal and background noise, indicating overall signal quality.\nIt is typically expressed in dB. Higher values represent cleaner and more stable signals, while lower values indicate higher interference."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SNR（信噪比）用于衡量有效信号与背景噪声之间的比例，反映当前网络连接质量。\n单位通常为 dB，数值越高表示信号质量越好。"
          }
        }
      }
    },

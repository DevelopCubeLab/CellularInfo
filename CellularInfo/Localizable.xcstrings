    "InstallPathLockedMessage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ The system directory for IPCC installation is locked. The IPCC file cannot be installed successfully. It is recommended to unlock it before proceeding.\n\nDo you want to continue installation?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️安装IPCC的系统目录已被锁定，无法成功安装IPCC文件，建议解锁后再安装IPCC\n\n是否继续安装?"
          }
        }
      }

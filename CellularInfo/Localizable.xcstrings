      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Failed to change app icon. Please ensure the Bundle ID used for code signing matches the provisioning profile, otherwise the icon cannot be changed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换应用图标失败，请确保证书签名时使用的 Bundle ID 与描述文件中的 Bundle ID 完全一致，否则无法切换图标。"
          }
        }
      }
    },
    "ChannelNumber" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4G (LTE)  Downlink Channel Number(EARFCN DL): %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4G(LTE)下行信道编号(EARFCN DL): %@"
          }
        }
      }
    },
    "ChannelNumberHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EARFCN DL(E-UTRA Absolute Radio Frequency Channel Number Downlink) Represents the standardized channel number for the LTE (4G) downlink frequency. This value can be used to determine the current frequency band (Band) and the corresponding actual downlink frequency (MHz). It is used for network identification and spectrum management, not for data encoding or signal strength.\nThe channel number identifies the radio frequency used by the current cellular connection. Different technologies (LTE / 5G / 3G) use different numbering schemes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EARFCN DL(E-UTRA Absolute Radio Frequency Channel Number Downlink)\n表示 LTE（4G）网络下行频率的标准化信道编号。通过该编号可以确定当前连接的频段（Band）以及对应的实际下行频率（MHz）。该值用于网络识别与频谱管理，并非数据编码或信号强度指标。\n信道号用于标识当前蜂窝连接所使用的无线频率，不同通信技术（如4G/5G/3G）使用不同的编号方式。"
          }
        }
      }
    },

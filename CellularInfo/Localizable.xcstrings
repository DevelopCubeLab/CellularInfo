    "DowngradeInstallIPCCMessage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An IPCC file for %1$@ is already installed.\nThe selected IPCC version is lower than the currently installed version.\n\nIPCC file version: %2$@\n\nDirect downgrade of the IPCC is not supported by the system.\nContinuing with the installation will cause the system to restore the carrier bundle to the default version.\n\nDo you want to continue with the installation?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已经安装%1$@的IPCC文件\n当前选择的IPCC文件低于已安装的IPCC版本\n\nIPCC文件版本: %2$@\n\n系统不支持直接降级IPCC版本，继续安装此IPCC会导致系统恢复IPCC为系统默认版本\n\n是否继续安装此IPCC文件？"
          }
        }
      }
    },

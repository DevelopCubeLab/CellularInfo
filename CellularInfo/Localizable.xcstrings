    "NrFrequencyRange" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5G (NR) Frequency Range: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5G(NR)频率范围: %@"
          }
        }
      }
    },
    "NrFrequencyRangeHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicates the frequency range currently used by the active 5G connection and is depend on the device's support capabilities and network support status. Sub-6 (FR1) provides wider coverage with moderate speeds, while mmWave (FR2) delivers higher throughput but with significantly limited coverage."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5G(NR)频率范围5G (NR) Frequency Range表示当前5G连接所使用的频率范围，依赖设备支持能力和网络支持情况。Sub-6 频段覆盖范围更广但速率较低，毫米波（mmWave）速率更高但覆盖范围较小。"
          }
        }
      }
    },

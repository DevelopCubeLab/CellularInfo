    "IPCCDowngradedMessage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPCC installation failed. Direct downgrade of the IPCC is not supported by the system.\nThe carrier bundle for %1$@ has been restored to the default version.\nVersion %2$@ has been removed by the system.\nTo use version %3$@, please install this IPCC file again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装IPCC失败，系统不支持直接降级IPCC版本。已将%1$@的IPCC恢复为系统默认版本。\n%2$@版本的IPCC已被系统移除，如需使用%3$@版本，请再次安装该IPCC文件。"
          }
        }
      }
    },

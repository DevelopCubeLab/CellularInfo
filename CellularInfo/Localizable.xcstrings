    "ScreenCaptureMessage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have just taken a screenshot or screen recording. Sensitive information such as IMSI, ICCID, and IMEI may still be visible.\n\nPlease avoid sharing this screenshot or screen recording file to prevent potential data leakage.\n\nYou can tap the 🔒 icon in the top-right corner to hide sensitive information, or disable this alert in Settings."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您刚刚进行了截图或屏幕录制，IMSI、ICCID、IMEI 等敏感信息可能仍然可见。\n\n为防止信息泄露，请避免分享该截图或屏幕录制文件。\n\n您可以点击右上角的🔒图标隐藏敏感信息，或在设置中关闭此提示。"
          }
        }
      }

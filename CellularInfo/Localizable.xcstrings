    "RSCP" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSCP: %@ dBm"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接收信号码功率(RSCP): %@ dBm"
          }
        }
      }
    },
    "RSCPHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSCP(Received Signal Code Power) measures how strong the 3G signal is that your phone receives from the cell tower.\nA higher (less negative) value means a stronger signal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSCP(Received Signal Code Power)接收信号码功率表示手机从基站接收到的 3G 信号强度。\n数值越高（越接近 0），信号越强。"
          }
        }
      }
    },
    "RSRP" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSRP: %@ dBm"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "参考信号接收功率(RSRP): %@ dBm"
          }
        }
      }
    },
    "RSRPHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSRP (Reference Signal Received Power) is a key metric used in 4G (LTE) and 5G networks to measure cellular signal strength, expressed in dBm. It represents the signal power received from the base station by the device.\nA higher value (closer to 0 dBm) indicates a stronger signal, while a lower value (e.g., -110 dBm) indicates a weaker signal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSRP（参考信号接收功率）是 4G(LTE)/5G 网络中衡量基站信号强度的核心指标，单位为 dBm，表示手机接收到的基站信号强度。\n数值越高（越接近 0），信号越强，数值越小（如 -110 dBm），信号越弱。"
          }
        }
      }
    },
    "RunCompatibilityCheck" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Run Compatibility Check"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运行兼容性检测"

    "Save" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存"
          }
        }
      }
    },
    "SaveActivationTicketConfirmMessage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️Please confirm that this activation ticket belongs to the current device.\n\nIf the ticket is invalid or does not match the device, it will be rejected by the system and may cause the device to enter an unactivated state. If Find My is enabled, you may need to re-enter your account password to unlock the device.\n\nDo you want to save and replace the current activation ticket?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️请确认该基带激活信息属于当前设备。\n\n如果激活信息无效或与设备不匹配，系统将拒绝该信息，并可能导致设备进入未激活状态。若设备已开启“查找”功能，您可能需要重新输入账户密码以解锁设备。\n\n是否确认保存并替换当前的基带激活信息？"
          }
        }
      }
    },
    "SaveActivationTicketFailedMessage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Failed to save the activation ticket. Please try again later."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存基带激活信息失败，请稍后重试"
          }
        }
      }
    },
    "SaveActivationTicketSuccessfulMessage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The activation ticket has been saved successfully and will take effect after a restart.\n\nIf the device enters the activation screen after rebooting, it means the ticket is invalid or does not match the device, and has been rejected by the system.\n\nWould you like to restart now? You can also restart the device later."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基带激活信息已成功保存，重启设备后生效。\n\n如果重启后设备进入激活界面，说明当前激活信息无效或与设备不匹配，系统已拒绝该激活信息。\n\n是否立即重启？您也可以稍后手动重启设备。"
          }
        }
      }
    },
    "SaveActiveBandsWarningMessage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save the current network band settings?\nIncorrect band settings may cause cellular network issues, such as “No Service”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存当前设定的网络频段设置?\n错误的频段设置可能会导致蜂窝网络出现“无服务”等异常情况。"
          }
        }
      }
    },

    },
    "InstallIPCCFailedMessage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installation of IPCC failed, please check the validity of the IPCC file and try again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装IPCC失败，请检查IPCC文件的有效性后再试一次"
          }
        }
      }
    },
    "InstallIPCCFailedWithPathLockedMessage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPCC installation failed. The installation directory is locked. Please unlock it and try again.\n\nLocked paths: \n%@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装IPCC失败，安装目录被锁定，请先解除锁定后再次安装\n\n被锁定的目录: \n%@"
          }
        }
      }
    },
    "InstallIPCCSuccessfulMessage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The IPCC for %1$@ (version %2$@) was installed successfully.\nPlease wait while the system refreshes the cellular network status."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@版本的IPCC安装成功，请等待系统刷新蜂窝网络状态"
          }
        }
      }
    },
    "InstallIPCCTips" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Installing an IPCC file generally does not improve signal strength or network performance.\n\nPlease ensure that the IPCC file is compatible with your device, carrier, and modem configuration. If the cellular plan is roaming, install the IPCC file for its home carrier instead of the current roaming network.\nAn incompatible IPCC may result in incorrect carrier settings or no effect at all.\n\nDo not trust IPCC files from unofficial or unknown sources. This application does not provide or include any preloaded IPCC files.\nIt is strongly recommended to extract IPCC files from official IPSW firmware to ensure integrity and compatibility.\n\nYou do not need to worry about SIM slot selection, the system will automatically match the appropriate slot.\n\nProceed with caution."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ 安装 IPCC 文件通常不会提升信号强度或网络性能。\n\n请确保所使用的 IPCC 文件与您的设备、运营商及基带配置相匹配。如果您的蜂窝数据卡正在漫游状态，请安装蜂窝数据卡归属运营商的IPCC文件，而非漫游网络的IPCC。\n不兼容的 IPCC 可能导致运营商配置异常，或出现无服务，或完全无效果。\n\n请勿轻信任何非官方或来源不明的 IPCC 文件，本应用程序未提供或预置任何 IPCC 文件。\n建议您从官方 IPSW 固件中自行提取 IPCC，以确保其完整性与兼容性。\n\n您无需关心安装的 IPCC 所在卡槽情况，系统会自动匹配相应的卡槽。\n\n请谨慎操作。"
          }
        }
      }
    },
    "InstallIPCCUpgradedFailedMessage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The attempt to upgrade %1$@ from version %2$@ to %3$@ failed.\nThe IPCC file may be incompatible with the current system version."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尝试将%1$@从%2$@升级为%3$@失败，可能是当前版本IPCC文件不兼容当前系统版本"
          }
        }
      }
    },

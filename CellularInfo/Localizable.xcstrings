    "NotInstalledIPCCAlertMessage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ No IPCC configuration detected on this device.\n\nUsing the “Lock Network Mode” feature without IPCC installed may result in loss of cellular service. Since the carrier configuration cannot be restored to the system default, network connectivity may not be recoverable.\n\nIt is recommended to install IPCC before proceeding."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ 未检测到当前设备已安装 IPCC。\n\n在未安装 IPCC 的情况下使用“锁定网络类型”功能，一旦出现无服务，由于无法将运营商配置恢复为系统默认版本，可能导致网络连接无法恢复。\n\n建议先安装 IPCC 后再继续操作。"
          }
        }
      }
    },

    "AllowInstallEmbeddedSIMHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses official system APIs to check whether this device is allowed to install an eSIM. The result may take a few seconds to appear. If data acquisition is abnormal, please restart the application and try again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过官方接口查询设备的激活策略是否允许安装 eSIM，获取结果通常需要几秒钟时间。 如果数据获取异常，您可以重新启动应用程序后再试一次"
          }

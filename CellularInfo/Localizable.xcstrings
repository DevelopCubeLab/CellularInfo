    },
    "ServingLocationAreaCodeHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serving Location Area Code (LAC) identifies the approximate service area of the device within the operator’s network. This parameter mainly originates from 2G / 3G networks. In 4G(LTE) / 5G networks, the Tracking Area Code (TAC) is typically used instead. However, in some 4G(LTE) / 5G environments, the device may still retain LAC information for purposes such as voice fallback or inter-network interoperability."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务小区位置区码LAC(Serving Location Area Code)用于标识设备在运营商网络中的大致服务区域，该参数主要来源于 2G / 3G 网络，在 4G / 5G 网络中通常使用 TAC（跟踪区码）。在部分 4G / 5G 网络环境下设备仍可能保留此信息用于语音回落或网络连接"
          }
        }
      }
    },

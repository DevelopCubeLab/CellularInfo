    "restoreIPCCToSystemTips" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ This operation will remove all installed IPCC files and restore the carrier bundle to the default version provided by the current system firmware.\n\nAll custom IPCC modifications will be permanently removed. This operation will reset carrier-related configurations and remove all custom settings.\nYou may reinstall any IPCC files if needed.\n\nProceed with caution."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ 此操作将删除所有已安装的 IPCC 文件，并恢复为当前系统版本出厂自带的运营商配置（IPCC）。\n\n所有已安装的自定义 IPCC 修改将被永久移除。此操作会重置运营商相关配置，并移除所有自定义设置。您可以再次安装您需要的 IPCC 文件。\n\n请谨慎操作。"
          }
        }
      }
    },

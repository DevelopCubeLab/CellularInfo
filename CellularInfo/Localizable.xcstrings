    "PUKAttemptHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Displays the remaining PUK attempt count for the current SIM card. You can contact your carrier to obtain the PUK for your SIM card.\nPUK typically allows up to 10 attempts. If all attempts are used, the SIM card will be permanently locked and cannot be recovered. You will need to contact your carrier for a replacement SIM."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示当前 SIM 卡剩余的 PUK 尝试次数。\n您可以联系您的运营商获取PUK\nPUK 通常仅允许 10 次输入机会，用尽后 SIM 卡将永久锁定，并且无法恢复，您需要联系运营商更换SIM卡。"
          }
        }
      }
    },

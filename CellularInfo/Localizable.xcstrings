    "MaximumTransmitPowerLimitHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximum UE transmit power indicates the maximum transmit power permitted under current network conditions. This limit is determined by device capabilities, regulatory constraints, and network power control policies, and may affect coverage range and power consumption."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大发射功率上限(Maximum UE transmit power) 表示设备在当前网络条件下允许的最大发射功率上限，由终端能力、监管要求以及网络侧功率控制策略共同决定，可能影响信号覆盖范围与功耗表现。"
          }
        }
      }

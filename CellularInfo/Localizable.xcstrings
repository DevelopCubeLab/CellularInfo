    "ECN0Hint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ec/No(Energy per chip over Noise density) measures the quality of the 3G signal by comparing signal energy to background noise.\nA higher value (closer to 0) means a cleaner and more stable signal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ec/No(Energy per chip over Noise density)码片能量与噪声比表示3G信号的质量，它反映信号与干扰噪声之间的比例。\n数值越高（越接近 0），信号越清晰、越稳定。"
          }
        }
      }
    },
